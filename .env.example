# Supabase project URL and public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Use the Supabase service-role key. Never prefix it with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin. Match Supabase Site URL and omit the trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay keys and webhook secret. Use test keys in staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server only. Generate with openssl rand -hex 32.
RSVP_RATE_LIMIT_SECRET=
